@model EventDetailVm
@{ ViewData["Title"] = Model.Event.Title; }
<a asp-action="Index" class="back-link">← All events</a><section class="detail-hero">@if (!string.IsNullOrWhiteSpace(Model.Event.BannerUrl)) { <img class="event-banner"
	 src="@Url.Action("Banner", "ParticipantEvents", new { id = Model.Event.Id })"
	 alt="Banner for @Model.Event.Title" /> }<div class="detail-copy"><span class="eyebrow">@Model.Event.EventType · @Model.Event.DistanceKm km</span><h1>@Model.Event.Title</h1><p>@Model.Event.Description</p><div class="event-meta"><span>◷ @Model.Event.Date.ToString("dddd, dd MMMM yyyy")</span><span>⌖ @Model.Event.VenueName, @Model.Event.City</span></div></div></section>
<section class="section-heading"><div><span class="eyebrow">Choose your race</span><h2>Available categories</h2></div></section><div class="category-grid">@foreach (var cat in Model.Categories) { <article class="category-card"><div><span class="type-pill">@cat.CategoryType</span><h3>@cat.Name</h3><p>@(cat.DistanceKm is not null ? $"{cat.DistanceKm} km" : $"Age {cat.MinAge}–{cat.MaxAge}") · Starts @cat.StartTime.ToString("HH:mm")</p></div><div class="card-bottom"><strong>R @cat.EntryFeeZar.ToString("N2")</strong><form asp-action="Enrol" asp-route-id="@Model.Event.Id" method="post"><input type="hidden" name="CategoryId" value="@cat.Id" /><button class="btn btn-accent btn-sm">Enter this category</button></form></div></article> }</div>
