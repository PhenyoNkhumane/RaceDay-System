@model List<EventVm>
@{ ViewData["Title"] = "Manage events"; }
<div class="page-title page-title-row"><div><span class="eyebrow">Organiser workspace</span><h1>Your events</h1><p>Create and manage your event calendar.</p></div><a class="btn btn-accent" asp-action="Create">+ New event</a></div>
<div class="event-grid">@foreach (var ev in Model) { <article class="event-card">@if (!string.IsNullOrWhiteSpace(ev.BannerUrl)) { <img class="event-banner"
	 src="@Url.Action("Banner", "OrganiserEvents", new { id = ev.Id })"
	 alt="Banner for @ev.Title" /> } else { <div class="event-banner banner-placeholder"><span>@ev.EventType</span><b>@ev.DistanceKm km</b></div> }<div class="event-card-body"><div class="card-top"><span class="status-badge status-neutral">@ev.Status</span><time>@ev.Date.ToString("dd MMM yyyy")</time></div><h3>@ev.Title</h3><p class="muted">@ev.VenueName · @ev.City</p><div class="manage-links"><a asp-controller="OrganiserCategories" asp-action="Index" asp-route-eventId="@ev.Id">Categories</a><a asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@ev.Id">Enrolments</a><a asp-controller="OrganiserResults" asp-action="Index" asp-route-eventId="@ev.Id">Results</a></div><div class="card-bottom"><a class="btn btn-outline-dark btn-sm" asp-action="Edit" asp-route-id="@ev.Id">Edit</a><form asp-action="Delete" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Delete this event? Events with categories cannot be deleted.');"><button class="btn btn-outline-danger btn-sm">Delete</button></form></div></div></article> }</div>
@if (Model.Count == 0) { <div class="empty-state"><p>You haven’t created an event yet.</p><a class="btn btn-accent" asp-action="Create">Create your first event</a></div> }
