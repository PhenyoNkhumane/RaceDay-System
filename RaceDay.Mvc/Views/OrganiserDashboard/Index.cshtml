@model List<EventSummaryVm>
@{ ViewData["Title"] = "Organiser dashboard"; var total = Model.Sum(x => x.EnrolmentCount); var upcoming = Model.Count(x => x.Upcoming); }
<section class="hero"><div><span class="eyebrow">Organiser workspace</span><h1>Make race day run smoothly.</h1><p>Manage your events, follow enrolments and publish results from one place.</p><a class="btn btn-accent" asp-controller="OrganiserEvents" asp-action="Create">Create an event <span>↗</span></a></div><div class="hero-stats"><div><b>@Model.Count</b><span>Total events</span></div><div><b>@total</b><span>Active enrolments</span></div><div><b>@upcoming</b><span>Upcoming</span></div></div></section>
<div class="section-heading"><div><span class="eyebrow">Your calendar</span><h2>Events at a glance</h2></div><a asp-controller="OrganiserEvents" asp-action="Index" class="text-link">Manage all events →</a></div>
<div class="dashboard-events">@foreach (var item in Model) { <article class="dashboard-event"><div class="event-date-tile"><b>@item.Event.Date.ToString("dd")</b><span>@item.Event.Date.ToString("MMM")</span></div><div class="dashboard-event-info"><span class="type-pill">@item.Event.EventType</span><h3>@item.Event.Title</h3><p>@item.Event.VenueName · @item.Event.City</p></div><div class="dashboard-count"><b>@item.EnrolmentCount</b><span>enrolments</span></div><div class="dashboard-actions"><a asp-controller="OrganiserEvents" asp-action="Edit" asp-route-id="@item.Event.Id">Edit event</a><a asp-controller="OrganiserEnrolments" asp-action="Index" asp-route-eventId="@item.Event.Id">Enrolments</a></div></article> }</div>
@if (Model.Count == 0) { <div class="empty-state"><h2>Start with your first event</h2><p>Publish an event and participants can begin entering.</p><a class="btn btn-accent" asp-controller="OrganiserEvents" asp-action="Create">Create an event</a></div> }
