@model List<RegistrationVm>
@{ ViewData["Title"] = "Event enrolments"; }
<a asp-controller="OrganiserEvents" asp-action="Index" class="back-link">← Your events</a><div class="page-title"><span class="eyebrow">Participant list</span><h1>Event enrolments</h1><p>Review participants, their chosen categories and enrolment status.</p></div><div class="table-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Enrolled</th><th>Status</th><th>Payment</th><th>Bib</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td class="fw-semibold">@row.ParticipantName</td><td>@row.CategoryName</td><td>@row.RegistrationDate.ToString("dd MMM yyyy")</td><td><span class="status-badge @(row.Status == "Active" ? "status-confirmed" : "status-cancelled")">@(row.Status == "Active" ? "Confirmed" : row.Status)</span></td><td><span class="status-badge @(row.PaymentStatus == "Paid" ? "status-paid" : row.PaymentStatus == "Pending" ? "status-pending" : "status-neutral")">@row.PaymentStatus</span></td><td>@row.AssignedBibNumber</td></tr> }</tbody></table></div>@if (Model.Count == 0) { <div class="empty-state"><p>No participants have entered this event yet.</p></div> }</div>
