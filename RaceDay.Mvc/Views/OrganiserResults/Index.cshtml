@model List<ResultVm>
@{ ViewData["Title"] = "Event results"; var registrations = ViewBag.Registrations as List<RegistrationVm> ?? []; var eventId = (int)(ViewBag.EventId ?? 0); var recorded = Model.Where(r => r.RegistrationId.HasValue).Select(r => r.RegistrationId!.Value).ToHashSet(); }
<a asp-controller="OrganiserEvents" asp-action="Index" class="back-link">Back to your events</a>
<div class="page-title"><span class="eyebrow">After the finish</span><h1>Enter results</h1><p>Record race times and finishing positions for enrolled participants.</p></div>
<div class="two-column">
    <div class="form-panel"><h2>Record a result</h2><form asp-action="Save" method="post"><input type="hidden" name="eventId" value="@eventId" /><div class="mb-3"><label class="form-label">Participant / category</label><select name="RegistrationId" class="form-select" required><option value="">Choose an enrolment</option>@foreach (var reg in registrations.Where(r => !recorded.Contains(r.Id))) { <option value="@reg.Id">@reg.ParticipantName - @reg.CategoryName</option> }</select></div><div class="row"><div class="col mb-3"><label class="form-label">Gun time</label><input name="GunTime" type="time" step="1" class="form-control" /></div><div class="col mb-3"><label class="form-label">Net time</label><input name="NetTime" type="time" step="1" class="form-control" /></div></div><div class="row"><div class="col mb-3"><label class="form-label">Overall position</label><input name="OverallPosition" type="number" min="1" class="form-control" /></div><div class="col mb-3"><label class="form-label">Category position</label><input name="CategoryPosition" type="number" min="1" class="form-control" /></div></div><div class="mb-4"><label class="form-label">Result status</label><select name="Status" class="form-select"><option>Finished</option><option>DNF</option><option>DNS</option><option>DQ</option></select></div><button class="btn btn-accent">Publish result</button></form></div>
    <div class="stack-list">@foreach (var result in Model) { <article class="list-card"><div><span class="type-pill">@result.Status</span><h3>@result.CategoryName</h3><p>@(result.FinishTime?.ToString("HH:mm:ss") ?? "No finish time") - Position @(result.OverallPosition?.ToString() ?? "-")</p></div></article> }</div>
</div>
