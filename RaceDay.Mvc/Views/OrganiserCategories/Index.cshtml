@model List<CategoryVm>
@{ ViewData["Title"] = "Event categories"; var disciplines = ViewBag.Disciplines as List<DisciplineVm> ?? []; var eventId = (int)(ViewBag.EventId ?? 0); }
<a asp-controller="OrganiserEvents" asp-action="Index" class="back-link">← Your events</a><div class="page-title"><span class="eyebrow">Event setup</span><h1>Categories</h1><p>Add age or distance divisions to this event.</p></div><div class="two-column"><div class="form-panel"><h2>Add a category</h2><form asp-action="Create" method="post"><input type="hidden" name="EventId" value="@eventId" /><div class="mb-3"><label class="form-label">Category name</label><input name="Name" class="form-control" required /></div><div class="row"><div class="col mb-3"><label class="form-label">Type</label><select name="CategoryType" class="form-select"><option>Distance</option><option>Age</option></select></div><div class="col mb-3"><label class="form-label">Discipline</label><select name="DisciplineId" class="form-select" required>@foreach (var d in disciplines) { <option value="@d.Id">@d.Name</option> }</select></div></div><div class="row"><div class="col mb-3"><label class="form-label">Distance km</label><input name="DistanceKm" type="number" step="0.1" class="form-control" /></div><div class="col mb-3"><label class="form-label">Min age</label><input name="MinAge" type="number" class="form-control" /></div><div class="col mb-3"><label class="form-label">Max age</label><input name="MaxAge" type="number" class="form-control" /></div></div><div class="row"><div class="col mb-3"><label class="form-label">Entry fee (R)</label><input name="EntryFeeZar" type="number" step="0.01" min="0" class="form-control" required /></div><div class="col mb-3"><label class="form-label">Capacity</label><input name="MaxSlots" type="number" min="1" class="form-control" required /></div><div class="col mb-3"><label class="form-label">Start time</label><input name="StartTime" type="time" class="form-control" required /></div></div><button class="btn btn-accent">Add category</button></form></div><div class="stack-list">@foreach (var cat in Model) { <article class="list-card"><div><span class="type-pill">@cat.CategoryType</span><h3>@cat.Name</h3><p>@(cat.DistanceKm is null ? $"Age {cat.MinAge}–{cat.MaxAge}" : $"{cat.DistanceKm} km") · R @cat.EntryFeeZar.ToString("N2") · @cat.MaxSlots places</p><details class="mt-3"><summary class="btn btn-outline-dark btn-sm">Edit category</summary><form asp-action="Update" method="post" class="mt-3"><input type="hidden" name="Id" value="@cat.Id" /><input type="hidden" name="EventId" value="@eventId" /><input type="hidden" name="DisciplineId" value="@cat.DisciplineId" /><label class="form-label">Category name</label><input name="Name" value="@cat.Name" class="form-control mb-2" required /><label class="form-label">Type</label><select name="CategoryType" class="form-select mb-2"><option value="Distance" selected="@(cat.CategoryType == "Distance")">Distance</option><option value="Age" selected="@(cat.CategoryType == "Age")">Age</option></select><div class="row"><div class="col"><label class="form-label">Distance km</label><input name="DistanceKm" type="number" step="0.1" value="@cat.DistanceKm" class="form-control mb-2" /></div><div class="col"><label class="form-label">Min age</label><input name="MinAge" type="number" value="@cat.MinAge" class="form-control mb-2" /></div><div class="col"><label class="form-label">Max age</label><input name="MaxAge" type="number" value="@cat.MaxAge" class="form-control mb-2" /></div></div><div class="row"><div class="col"><label class="form-label">Entry fee (R)</label><input name="EntryFeeZar" type="number" step="0.01" min="0" value="@cat.EntryFeeZar" class="form-control mb-2" required /></div><div class="col"><label class="form-label">Capacity</label><input name="MaxSlots" type="number" min="1" value="@cat.MaxSlots" class="form-control mb-2" required /></div><div class="col"><label class="form-label">Start time</label><input name="StartTime" type="time" value="@cat.StartTime.ToString("HH:mm")" class="form-control mb-2" required /></div></div><button class="btn btn-accent btn-sm">Save category</button></form></details></div><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@cat.Id" /><input type="hidden" name="eventId" value="@eventId" /><button class="btn btn-outline-danger btn-sm">Remove</button></form></article> }</div></div>
