@model EventListVm
@{ ViewData["Title"] = "Find events"; }
<section class="hero hero-compact"><div><span class="eyebrow">Your next start line</span><h1>Find your next event.</h1><p>Browse upcoming runs, walks and rides across the country.</p></div><div class="hero-stamp">RD<br /><b>26</b></div></section>
<form method="get" class="filter-bar"><select name="type" class="form-select"><option value="">All event types</option><option selected="@(Model.Type == "Run")">Run</option><option selected="@(Model.Type == "Walk")">Walk</option><option selected="@(Model.Type == "Cycle")">Cycle</option></select><input name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" aria-label="From date" /><input name="maxDistance" type="number" min="0" step="0.1" value="@Model.MaxDistance" class="form-control" placeholder="Max km" aria-label="Maximum distance" /><button class="btn btn-dark">Filter events</button></form>
<div class="section-heading"><div><span class="eyebrow">On the calendar</span><h2>Upcoming events</h2></div><span class="count-pill">@Model.Events.Count events</span></div>
<div class="event-grid">@foreach (var ev in Model.Events) { <article class="event-card">@if (!string.IsNullOrWhiteSpace(ev.BannerUrl)) { <img class="event-banner" src="@ev.BannerUrl" alt="Banner for @ev.Title" /> } else { <div class="event-banner banner-placeholder"><span>@ev.EventType</span><b>@ev.DistanceKm km</b></div> }<div class="event-card-body"><div class="card-top"><span class="type-pill">@ev.EventType</span><time>@ev.Date.ToString("dd MMM yyyy")</time></div><h3>@ev.Title</h3><p class="muted">@ev.VenueName · @ev.City, @ev.Province</p><div class="card-bottom"><strong>@ev.DistanceKm km</strong><a class="btn btn-accent btn-sm" asp-action="Details" asp-route-id="@ev.Id">Event details</a></div></div></article> }</div>
@if (Model.Events.Count == 0) { <div class="empty-state"><h2>No matching events</h2><p>Try widening the date or distance filters.</p></div> }
