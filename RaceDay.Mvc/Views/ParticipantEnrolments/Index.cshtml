@model List<RegistrationVm>
@{ ViewData["Title"] = "My enrolments"; }
<div class="page-title"><span class="eyebrow">Your race calendar</span><h1>My enrolments</h1><p>Every event you have entered, with its current enrolment status.</p></div>
<div class="table-card"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Category</th><th>Enrolment</th><th>Payment</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td class="fw-semibold">@item.EventName</td><td>@item.EventDate?.ToString("dd MMM yyyy")</td><td>@item.CategoryName</td><td><span class="status-badge @(item.Status == "Active" ? "status-confirmed" : "status-cancelled")">@(item.Status == "Active" ? "Confirmed" : item.Status)</span></td><td>@item.PaymentStatus</td></tr> }</tbody></table></div>@if (Model.Count == 0) { <div class="empty-state"><p>You haven’t entered an event yet.</p><a asp-controller="ParticipantEvents" asp-action="Index" class="btn btn-accent">Browse events</a></div> }</div>
