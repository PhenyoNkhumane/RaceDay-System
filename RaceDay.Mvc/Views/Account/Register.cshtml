@model RegisterVm
@{ ViewData["Title"] = "Create account"; }
<div class="auth-wrap"><div class="auth-card"><span class="eyebrow">Join the community</span><h1>Create your account</h1>
<form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="FirstName" class="form-label">First name</label><input asp-for="FirstName" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="LastName" class="form-label">Last name</label><input asp-for="LastName" class="form-control" /></div></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div><div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" /><small class="form-hint">At least 12 characters, with upper and lower case, a number, and a symbol.</small></div><div class="mb-3"><label asp-for="IdNumberOrPassport" class="form-label">ID number or passport</label><input asp-for="IdNumberOrPassport" class="form-control" /></div><div class="mb-3"><label asp-for="Role" class="form-label">Account type</label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select></div><div class="mb-3"><label asp-for="AsaPermanentLicenseNumber" class="form-label">ASA permanent licence (optional)</label><input asp-for="AsaPermanentLicenseNumber" class="form-control" /></div><div class="mb-4"><label asp-for="OrganiserCode" class="form-label">Organiser invite code</label><input asp-for="OrganiserCode" class="form-control" /><small class="form-hint">Required only for organiser accounts.</small></div><button class="btn btn-accent w-100">Create account</button></form><p class="mt-4 mb-0">Already registered? <a asp-action="Login">Sign in</a></p></div></div>
